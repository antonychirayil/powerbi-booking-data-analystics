table Fact_Rides
	lineageTag: 9a433cff-2db3-4926-8677-dff4ca43f8e5

	measure 'QA Rating Out Of Range' =
			CALCULATE (
			    COUNTROWS ( Fact_Rides ),
			    FILTER (
			        Fact_Rides,
			        ( NOT ISBLANK ( Fact_Rides[Driver Rating] )
			            && NOT ( Fact_Rides[Driver Rating] >= 1 && Fact_Rides[Driver Rating] <= 5 ) )
			            || ( NOT ISBLANK ( Fact_Rides[Customer Rating] )
			            && NOT ( Fact_Rides[Customer Rating] >= 1 && Fact_Rides[Customer Rating] <= 5 ) )
			    )
			)
		formatString: #,0
		displayFolder: J. Operational Quality\QA
		lineageTag: e0c7d15c-7c11-4541-bca5-db25d8d51f57

	measure 'QA Non Positive Value Or Distance' =
			CALCULATE (
			    COUNTROWS ( Fact_Rides ),
			    FILTER (
			        Fact_Rides,
			        ( NOT ISBLANK ( Fact_Rides[Booking Value (INR)] ) && Fact_Rides[Booking Value (INR)] <= 0 )
			            || ( NOT ISBLANK ( Fact_Rides[Ride Distance (km)] ) && Fact_Rides[Ride Distance (km)] <= 0 )
			    )
			)
		formatString: #,0
		displayFolder: J. Operational Quality\QA
		lineageTag: 437f5040-ab60-4c43-992b-f9b000f49fc9

	measure 'QA Rating On Unrated Status' =
			CALCULATE (
			    COUNTROWS ( Fact_Rides ),
			    NOT ISBLANK ( Fact_Rides[Driver Rating] ),
			    Dim_Booking_Status[Booking Status] <> "Completed"
			)
		formatString: #,0
		displayFolder: J. Operational Quality\QA
		lineageTag: 6afc0a78-f0fd-435d-a333-ded629954247

	measure 'QA Revenue Without Payment Method' =
			CALCULATE (
			    COUNTROWS ( Fact_Rides ),
			    NOT ISBLANK ( Fact_Rides[Booking Value (INR)] ),
			    ISBLANK ( Fact_Rides[Payment Method] )
			)
		formatString: #,0
		displayFolder: J. Operational Quality\QA
		lineageTag: ac3d4ad2-51c1-453d-bb75-67b65e4f6bc1

	measure 'QA Quoted Identifiers' =
			CALCULATE (
			    COUNTROWS ( Fact_Rides ),
			    FILTER (
			        Fact_Rides,
			        SEARCH ( UNICHAR ( 34 ), Fact_Rides[Booking ID], 1, 0 ) > 0
			            || SEARCH ( UNICHAR ( 34 ), Fact_Rides[Customer ID], 1, 0 ) > 0
			    )
			)
		formatString: #,0
		displayFolder: J. Operational Quality\QA
		lineageTag: 776cfc49-8264-4dea-8c8a-834c71f5cf36

	measure 'Total Bookings' = COUNTROWS ( Fact_Rides )

	measure 'Overall Performance Insight' = "Of " & FORMAT ( [Total Bookings], "#,0" ) & " bookings, " & FORMAT ( [Completion Rate], "0.0%" ) & " completed successfully, while " & FORMAT ( [Cancellation Rate], "0.0%" ) & " were cancelled and " & FORMAT ( [No Driver Found Rate], "0.0%" ) & " found no driver."
		displayFolder: K. Insights
		lineageTag: 5b2d168c-7690-4119-8876-0760dd93ccb5

	measure 'Highest Cancellation Vehicle Insight' =
			VAR _Table =
			    ADDCOLUMNS ( VALUES ( Dim_Vehicle[Vehicle Type] ), "RateVal", [Cancellation Rate] )
			VAR _Top = TOPN ( 1, _Table, [RateVal], DESC )
			VAR _Name = MAXX ( _Top, Dim_Vehicle[Vehicle Type] )
			VAR _Rate = MAXX ( _Top, [RateVal] )
			RETURN
			    _Name & " has the highest cancellation rate at " & FORMAT ( _Rate, "0.0%" ) & " of its bookings."
		displayFolder: K. Insights
		lineageTag: e6cb77c1-3bc7-456b-a93d-adfb90fe3ab4

	measure 'Rating Distribution Insight' =
			VAR _3 = CALCULATE ( [Rated Rides], Fact_Rides[Driver Rating Band] = "3★" )
			VAR _4 = CALCULATE ( [Rated Rides], Fact_Rides[Driver Rating Band] = "4★" )
			VAR _5 = CALCULATE ( [Rated Rides], Fact_Rides[Driver Rating Band] = "5★" )
			VAR _Total = [Rated Rides]
			RETURN
			    FORMAT ( DIVIDE ( _4, _Total ), "0.0%" ) & " of rated rides land in the 4★ band, vs " & FORMAT ( DIVIDE ( _3, _Total ), "0.0%" ) & " at 3★ and " & FORMAT ( DIVIDE ( _5, _Total ), "0.0%" ) & " at 5★."
		displayFolder: K. Insights
		lineageTag: 36a43784-0770-485e-816c-df47862d3699


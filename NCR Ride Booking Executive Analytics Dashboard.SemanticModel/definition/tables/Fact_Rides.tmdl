	partition Fact_Rides = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\MYPC\OneDrive\Documents\BIA\Power BI\August Assignment\ncr_ride_bookings.csv"), [Delimiter = ",", Columns = 21, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    RealNulls = Table.ReplaceValue(Headers, "null", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Q = Character.FromNumber(34),
				    CleanIds = Table.TransformColumns(RealNulls, {
				        {"Booking ID", each Text.Trim(Text.Remove(_, {Q})), type text},
				        {"Customer ID", each Text.Trim(Text.Remove(_, {Q})), type text}
				    }),
				    Trimmed = Table.TransformColumns(CleanIds, {
				        {"Booking Status", each if _ = null then null else Text.Trim(Text.Clean(_)), type text},
				        {"Vehicle Type", each if _ = null then null else Text.Trim(Text.Clean(_)), type text},
				        {"Pickup Location", each if _ = null then null else Text.Trim(Text.Clean(_)), type text},
				        {"Drop Location", each if _ = null then null else Text.Trim(Text.Clean(_)), type text},
				        {"Reason for cancelling by Customer", each if _ = null then null else Text.Trim(Text.Clean(_)), type text},
				        {"Driver Cancellation Reason", each if _ = null then null else Text.Trim(Text.Clean(_)), type text},
				        {"Incomplete Rides Reason", each if _ = null then null else Text.Trim(Text.Clean(_)), type text},
				        {"Payment Method", each if _ = null then null else Text.Trim(Text.Clean(_)), type text}
				    }),
				    Dropped = Table.RemoveColumns(Trimmed, {"Cancelled Rides by Customer", "Cancelled Rides by Driver", "Incomplete Rides"}),
				    Typed = Table.TransformColumnTypes(Dropped, {{"Date", type date}, {"Time", type time}, {"Booking ID", type text}, {"Booking Status", type text}, {"Customer ID", type text}, {"Vehicle Type", type text}, {"Pickup Location", type text}, {"Drop Location", type text}, {"Avg VTAT", type number}, {"Avg CTAT", type number}, {"Reason for cancelling by Customer", type text}, {"Driver Cancellation Reason", type text}, {"Incomplete Rides Reason", type text}, {"Booking Value", Int64.Type}, {"Ride Distance", type number}, {"Driver Ratings", type number}, {"Customer Rating", type number}, {"Payment Method", type text}}, "en-US"),
				    WithDateTime = Table.AddColumn(Typed, "Booking DateTime", each [Date] & [Time], type datetime),
				    WithHour = Table.AddColumn(WithDateTime, "Ride Hour", each Time.Hour([Time]), Int64.Type),
				    WithDaypart = Table.AddColumn(WithHour, "Time of Day", each if [Ride Hour] < 5 then "Late Night (00-04)" else if [Ride Hour] < 12 then "Morning (05-11)" else if [Ride Hour] < 17 then "Afternoon (12-16)" else if [Ride Hour] < 21 then "Evening (17-20)" else "Night (21-23)", type text),
				    WithBand = Table.AddColumn(WithDaypart, "Distance Band", each if [Ride Distance] = null then null else if [Ride Distance] <= 5 then "00-05 km" else if [Ride Distance] <= 10 then "05-10 km" else if [Ride Distance] <= 20 then "10-20 km" else if [Ride Distance] <= 30 then "20-30 km" else if [Ride Distance] <= 40 then "30-40 km" else "40-50 km", type text),
				    SortedForKey = Table.Sort(WithBand, {{"Booking DateTime", Order.Ascending}, {"Booking ID", Order.Ascending}}),
				    Keyed = Table.AddIndexColumn(SortedForKey, "Ride Key", 1, 1, Int64.Type),
				    Renamed = Table.RenameColumns(Keyed, {{"Date", "Ride Date"}, {"Time", "Ride Time"}, {"Avg VTAT", "Avg Pickup Wait (min)"}, {"Avg CTAT", "Avg Trip Duration (min)"}, {"Booking Value", "Booking Value (INR)"}, {"Ride Distance", "Ride Distance (km)"}, {"Driver Ratings", "Driver Rating"}, {"Reason for cancelling by Customer", "Customer Cancellation Reason"}, {"Incomplete Rides Reason", "Incomplete Ride Reason"}}),
				    Final = Table.ReorderColumns(Renamed, {"Ride Key", "Booking ID", "Customer ID", "Ride Date", "Ride Time", "Booking DateTime", "Ride Hour", "Time of Day", "Booking Status", "Vehicle Type", "Pickup Location", "Drop Location", "Avg Pickup Wait (min)", "Avg Trip Duration (min)", "Booking Value (INR)", "Payment Method", "Ride Distance (km)", "Distance Band", "Driver Rating", "Customer Rating", "Customer Cancellation Reason", "Driver Cancellation Reason", "Incomplete Ride Reason"})
				in
				    Final


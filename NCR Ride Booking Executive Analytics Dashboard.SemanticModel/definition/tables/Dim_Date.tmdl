		isNameInferred
		sourceColumn: [Date Key]

	partition Dim_Date = calculated
		mode: import
		source =
				VAR _Min = MIN ( Fact_Rides[Ride Date] )
				VAR _Max = MAX ( Fact_Rides[Ride Date] )
				VAR _Calendar = CALENDAR ( DATE ( YEAR ( _Min ), 1, 1 ), DATE ( YEAR ( _Max ), 12, 31 ) )
				RETURN
				ADDCOLUMNS (
				    _Calendar,
				    "Year", YEAR ( [Date] ),
				    "Quarter Number", QUARTER ( [Date] ),
				    "Quarter", "Q" & QUARTER ( [Date] ),
				    "Year Quarter", YEAR ( [Date] ) & "-Q" & QUARTER ( [Date] ),
				    "Month Number", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "MMMM" ),
				    "Month Short", FORMAT ( [Date], "MMM" ),
				    "Year Month", FORMAT ( [Date], "yyyy-MM" ),
				    "Month Year", FORMAT ( [Date], "MMM yyyy" ),
				    "Month Year Sort", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				    "Week Number", WEEKNUM ( [Date], 2 ),
				    "Year Week", YEAR ( [Date] ) & "-W" & FORMAT ( WEEKNUM ( [Date], 2 ), "00" ),
				    "Week Start Date", [Date] - WEEKDAY ( [Date], 2 ) + 1,
				    "Day", DAY ( [Date] ),
				    "Day of Week Number", WEEKDAY ( [Date], 2 ),
				    "Day of Week", FORMAT ( [Date], "dddd" ),
				    "Day of Week Short", FORMAT ( [Date], "ddd" ),
				    "Day Type", IF ( WEEKDAY ( [Date], 2 ) >= 6, "Weekend", "Weekday" ),
				    "Is Weekend", WEEKDAY ( [Date], 2 ) >= 6,
				    "Date Key", YEAR ( [Date] ) * 10000 + MONTH ( [Date] ) * 100 + DAY ( [Date] )
				)

